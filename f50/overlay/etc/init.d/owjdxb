#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /usr/libexec/f50-nodebaby-guard
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() {
    /usr/local/owjdxb/stop.sh >/tmp/owjdxb-stop.log 2>&1
}
