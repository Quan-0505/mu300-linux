#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
    config_dir=/etc/daed
    state_db=$config_dir/daed.db
    legacy_db=
    if [ -s /etc/daed/wing.db ]; then
        legacy_db=/etc/daed/wing.db
    elif [ -s /etc/daed-kdae/wing.db ]; then
        legacy_db=/etc/daed-kdae/wing.db
    fi
    mkdir -p "$config_dir" /tmp/log/daed
    chmod 700 "$config_dir"
    if [ ! -s "$state_db" ] && [ -n "$legacy_db" ]; then
        (umask 077; /usr/bin/daed state migrate --from-wing-db "$legacy_db" --to "$state_db" > /tmp/log/daed/state-migration.json 2>&1) || return 1
    fi
    /usr/bin/daed validate -c "$config_dir/" --state "$state_db" --json > /tmp/log/daed/validate.json 2>&1 || return 1
    procd_open_instance
    procd_set_param command /bin/sh -c 'n=0; while ! ip -4 route show default | grep -q .; do n=$((n+1)); [ "$n" -ge 150 ] && break; sleep 1; done; exec /usr/bin/daed run -c "$1" --state "$2" --listen 0.0.0.0:2023' daed "$config_dir" "$state_db"
    if [ -s "$config_dir/trusted-ca.pem" ]; then
        procd_set_param env NETNS_LINK=veth SSL_CERT_FILE="$config_dir/trusted-ca.pem" DAED_PRODUCT_LOG_DIR=/tmp/log/daed
    else
        procd_set_param env NETNS_LINK=veth DAED_PRODUCT_LOG_DIR=/tmp/log/daed
    fi
    procd_set_param respawn 3600 5 0
    procd_set_param limits nofile="1048576 1048576"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
